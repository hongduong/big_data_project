# KRaft settings for apache/kafka:3.9.2 (env_file of the `kafka` service).
# The image turns every KAFKA_<NAME> variable into server.properties key <name>
# (lower-case, '_' -> '.'). Once any KAFKA_* config var is set, the image's default
# server.properties is NOT used, so the full set must be here.
# KAFKA_HEAP_OPTS and KAFKA_ADVERTISED_LISTENERS are set in docker-compose.yml
# (they take values from .env).

# Fixed cluster id (base64url of "stocklake-kafka1"); storage is formatted once with it.
CLUSTER_ID=c3RvY2tsYWtlLWthZmthMQ

# Single node: broker + controller.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# PLAINTEXT  kafka:9092  -> containers on the compose network
# EXTERNAL   <host>:9094 -> clients outside docker (published host port)
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,EXTERNAL://0.0.0.0:9094
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT

# Data on the kafka_data volume (directory exists in the image, owned by appuser).
KAFKA_LOG_DIRS=/var/lib/kafka/data

# One broker: every internal topic has RF 1.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# Topics are created explicitly by conf/kafka/create_topics.sh (`make topics`).
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_NUM_PARTITIONS=1

KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000
