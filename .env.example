# Copy to .env (not committed) and adjust. docker compose reads .env automatically.
# No secrets belong here.

COMPOSE_PROJECT_NAME=stocklake

# --- Image tags (pulled and checked on the PC 24/11/2026) ---
SPARK_IMAGE_BASE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
KAFKA_IMAGE=apache/kafka:3.9.2
HADOOP_IMAGE=apache/hadoop:3.3.6
PYTHON_IMAGE=python:3.11-slim

# --- Network exposure ---
# Interface the host ports bind to. HDFS, Spark and Kafka have no authentication:
# never use 0.0.0.0 on a shared network. On the PC set it to the Tailscale IP.
# 127.0.0.1 keeps everything local (reach it through SSH tunnels).
HOST_BIND=127.0.0.1
# Host name/IP that clients OUTSIDE the compose network use for Kafka (external
# listener). On the PC set it to the PC's Tailscale IP or hostname.
KAFKA_EXTERNAL_HOST=localhost

# --- Host ports (never 8000 / 9443: those belong to portainer) ---
KAFKA_EXTERNAL_PORT=9094
NAMENODE_HTTP_PORT=9870
NAMENODE_RPC_PORT=8020
DATANODE1_HTTP_PORT=9864
DATANODE2_HTTP_PORT=9865
DATANODE3_HTTP_PORT=9866
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER1_UI_PORT=8081
SPARK_WORKER2_UI_PORT=8082
SPARK_WORKER3_UI_PORT=8083
SPARK_DRIVER_UI_PORT=4040
DASHBOARD_PORT=8501

# --- Resource knobs (defaults = Planning table 2.2; total 23.5GB / 13 vCPU) ---
KAFKA_MEM_LIMIT=2g
KAFKA_CPUS=2
KAFKA_HEAP_OPTS=-Xms1g -Xmx1g
NAMENODE_MEM_LIMIT=1536m
NAMENODE_CPUS=1
HDFS_NAMENODE_OPTS=-Xmx1g
DATANODE_MEM_LIMIT=1g
DATANODE_CPUS=0.5
HDFS_DATANODE_OPTS=-Xmx512m
SPARK_MASTER_MEM_LIMIT=1g
SPARK_MASTER_CPUS=0.5
SPARK_WORKER_MEM_LIMIT=4g
SPARK_WORKER_CPUS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_DRIVER_MEM_LIMIT=2g
SPARK_DRIVER_CPUS=1
COLLECTOR_MEM_LIMIT=1g
COLLECTOR_CPUS=0.5
DASHBOARD_MEM_LIMIT=1g
DASHBOARD_CPUS=0.5

# --- App settings read by stocklake.common.config ---
# HDFS permissions are disabled (student cluster); this is only the name written as owner.
HDFS_USER=stocklake
